{
  "name": "edge-etf-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "node tools/build-original.mjs && tsc --noEmit && vite build",
    "original:prepare": "node tools/build-original.mjs",
    "build:mobile": "tsc --noEmit && node tools/build-bundle.mjs mobile",
    "build:site": "tsc --noEmit && node tools/build-bundle.mjs site",
    "mobile:sync": "npm run build:mobile && cap sync",
    "test": "node --experimental-strip-types --test src/domain.test.ts src/original/market-view.test.ts",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
